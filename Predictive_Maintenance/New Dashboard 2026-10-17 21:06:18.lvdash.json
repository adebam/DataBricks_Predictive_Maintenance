    {
      "name": "b0ab5482",
      "displayName": "events",
      "config": {
        "version": "1.1",
        "source": "predictivemaintenancecatalog.gold_data.events",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "total_count",
            "expr": "COUNT(*) OVER ()"
          }
        ],
        "measures": [
          {
            "name": "Total_Failure_Events",
            "expr": "COUNT(*)",
            "displayName": "Total Failure Events",
            "window": [
              {
                "order": "failure_mode",
                "range": "all",
                "semiadditive": "last"
              }
            ]
          },
          {
            "name": "Failure_Mode_Percentage",
            "expr": "ROUND(\n    100.0 * COUNT(*) /\n    NULLIF(MEASURE(Total_Failure_Events), 0),\n    2\n)",
            "displayName": "Failure Mode Percentage"
          }
        ]
      }
    },
    {
      "name": "1297f748",
      "displayName": "failure_events_dashboard",
      "queryLines": [
        "SELECT\n",
        "    UDI,\n",
        "    Type,\n",
        "    failure_mode\n",
        "FROM predictivemaintenancecatalog.gold_data.events"
      ]
    }
