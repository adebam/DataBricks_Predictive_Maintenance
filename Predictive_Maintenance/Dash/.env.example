# Start in DEMO mode to preview the dashboard without querying Databricks.
DEMO_MODE=true

# Databricks SQL Warehouse connection (required when DEMO_MODE=false).
# Use the workspace hostname without https://.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
# Local testing: PAT token; leave blank when using a service principal.
DATABRICKS_TOKEN=
# Alternative for EC2: service-principal OAuth M2M credentials.
# If both client_id/secret are filled, they take precedence over the PAT.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Queries run on the first page view, then only when Refresh Data is clicked.
# Keep the server snapshot on local EC2 disk for all Gunicorn workers.
# DASH_CACHE_DIR=/path/owned-by-the-app/.dash_cache
QUERY_CACHE_SECONDS=45

# Override table names here if your actual catalog/schema differs.
PREDICTIONS_TABLE=predictivemaintenancecatalog.gold_data.test_failure_predictions
# Raw 8,000-row population from Notebook 51 (not PSI binned reference table).
DRIFT_REFERENCE_TABLE=predictivemaintenancecatalog.gold_data.all_features
DRIFT_TABLE=predictivemaintenancecatalog.gold_data.prediction_monitoring_drift
DRIFT_ROLLING_TABLE=predictivemaintenancecatalog.gold_data.prediction_monitoring_drift_rolling
ALERTS_TABLE=predictivemaintenancecatalog.gold_data.prediction_monitoring_drift_alerts
ALERT_STATE_TABLE=predictivemaintenancecatalog.gold_data.prediction_monitoring_drift_alert_state
ALERT_EVENTS_TABLE=predictivemaintenancecatalog.gold_data.prediction_monitoring_drift_alert_events
CURRENT_FEATURES_TABLE=predictivemaintenancecatalog.gold_data.streaming
MONITORING_TABLE=predictivemaintenancecatalog.gold_data.prediction_monitoring
BRONZE_TABLE=predictivemaintenancecatalog.bronze_data_not_quality_checked.streaming

# Monitor the latest completed Lakeflow runs using Databricks SQL system tables.
# Default IDs were observed in November 6 SQL output; edit if jobs change.
MONITORED_JOB_IDS=1093257342514742,988061660710201,195467107464674,65480912120821
# Optional: use an existing custom run-status table instead of Lakeflow system tables.
PIPELINE_STATUS_TABLE=
