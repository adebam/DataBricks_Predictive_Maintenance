{
  "custom_summary": "Predictive Maintenance — Drift Detection Alert",
  "evaluation": {
    "source": {
      "name": "has_pending_event",
      "display": "has_pending_event",
      "aggregation": "AGGREGATION_UNSPECIFIED"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 0.0
      }
    },
    "notification": {
      "retrigger_seconds": 1,
      "notify_on_ok": false
    }
  },
  "schedule": {
    "quartz_cron_schedule": "0 0/10 * * * ?",
    "timezone_id": "America/Chicago"
  },
  "query_lines": [
    "WITH pending_events AS (",
    "    SELECT",
    "        event_id,",
    "        feature,",
    "        event_type,",
    "        severity,",
    "        ROUND(psi, 4) AS psi,",
    "        ks_pvalue,",
    "        recommended_action,",
    "        event_timestamp",
    "    FROM predictivemaintenance_dev.gold_data.prediction_monitoring_drift_alert_events",
    "    WHERE notification_required = TRUE",
    "      AND notification_status = 'PENDING'",
    ")",
    "SELECT",
    "    event_id, feature, event_type, severity, psi, ks_pvalue,",
    "    recommended_action, event_timestamp,",
    "    1 AS has_pending_event",
    "FROM pending_events",
    "UNION ALL",
    "SELECT",
    "    NULL AS event_id,",
    "    '(no pending drift events)' AS feature,",
    "    'NONE' AS event_type,",
    "    'NONE' AS severity,",
    "    0.0 AS psi,",
    "    CAST(NULL AS DOUBLE) AS ks_pvalue,",
    "    'No action required' AS recommended_action,",
    "    current_timestamp() AS event_timestamp,",
    "    0 AS has_pending_event",
    "WHERE NOT EXISTS (SELECT 1 FROM pending_events)",
    "ORDER BY has_pending_event DESC, psi DESC;"
  ],
  "custom_description_lines": [
    "Pending predictive maintenance drift events, including recovery notifications:<br><br>{{QUERY_RESULT_TABLE}}<br><br>SENT is recorded only after the delivery worker receives an SES delivery receipt."
  ]
}
