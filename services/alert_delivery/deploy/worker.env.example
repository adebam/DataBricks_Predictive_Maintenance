# Separate configuration and journal for each environment; no production defaults.
PM_CATALOG=predictivemaintenance_dev
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ALERT_SENDER=alerts@example.com
ALERT_RECIPIENT=operator@example.com
SES_CONFIGURATION_SET=pm-alerts-dev
RECEIPT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/REPLACE_FROM_STACK_OUTPUT
PM_DELIVERY_DB=/var/lib/pm-alert-delivery/deliveries.sqlite3
POLL_SECONDS=600
RETRY_SECONDS=3600
DATABRICKS_SERVER_HOSTNAME=REPLACE.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/REPLACE
# Dedicated M2M principal with SELECT/MODIFY on the two alert tables only.
DATABRICKS_CLIENT_ID=REPLACE
DATABRICKS_CLIENT_SECRET=REPLACE
# Use the EC2 instance role for AWS; do not put AWS access keys here.
